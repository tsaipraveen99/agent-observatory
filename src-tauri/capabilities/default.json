{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Main window: read-only access to Claude Code transcripts, nothing else",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "opener:default",
    {
      "identifier": "fs:allow-read-dir",
      "allow": [{ "path": "$HOME/.claude/projects" }, { "path": "$HOME/.claude/projects/**" }]
    },
    {
      "identifier": "fs:allow-read-text-file",
      "allow": [{ "path": "$HOME/.claude/projects/**" }]
    },
    {
      "identifier": "fs:allow-stat",
      "allow": [{ "path": "$HOME/.claude/projects" }, { "path": "$HOME/.claude/projects/**" }]
    },
    {
      "identifier": "fs:allow-exists",
      "allow": [{ "path": "$HOME/.claude/projects" }, { "path": "$HOME/.claude/projects/**" }]
    },
    {
      "identifier": "fs:allow-watch",
      "allow": [{ "path": "$HOME/.claude/projects" }, { "path": "$HOME/.claude/projects/**" }]
    }
  ]
}
